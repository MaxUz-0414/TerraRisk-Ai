# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# True when Cloudflare (or another proxy) serves your site over https
USE_HTTPS=False

# True = demo data (no GEE needed). Member A sets False when GEE works.
USE_FAKE_DATA=True
FREE_SEARCHES=5

# ---- Microservices (see ARCHITECTURE.md) ----
# inprocess = the services run inside Django (laptop, tests: nothing else to start)
# http      = the services are separate containers / processes (docker compose, scripts/run_services.py)
SERVICES_MODE=inprocess
# The shared secret the services check on every call (any long random text). REQUIRED for docker compose.
INTERNAL_TOKEN=change-me-to-a-long-random-text
# Only needed in http mode outside Docker (scripts/run_services.py prints the right values):
# ANALYSIS_URL=http://127.0.0.1:8101
# SATELLITE_URL=http://127.0.0.1:8102
# RISK_URL=http://127.0.0.1:8103
# ADVISORY_URL=http://127.0.0.1:8104
# REPORT_URL=http://127.0.0.1:8105
# BILLING_URL=http://127.0.0.1:8106
# GEOCODE_URL=http://127.0.0.1:8107
# CHATBOT_URL=http://127.0.0.1:8108

# ---- Map ----
# Optional: Google Maps place names/satellite on the map (Map Tiles API must be enabled and billing turned on in Google Cloud).
# Leave empty to use the free Esri satellite picture with Esri place-name labels.
GOOGLE_MAPS_API_KEY=
# Where the visitor's real IP is read from for the "where do users sign in from" charts (first header that is present wins).
CLIENT_IP_HEADERS=CF-Connecting-IP,X-Real-IP

# Optional: real AI advice (otherwise built-in template advice is used)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Earth Engine (Member A). These are read by the SATELLITE service.
# In Docker put the key file in ./secrets/ and set GEE_KEY_FILE=/run/secrets/gee-key.json
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=

# PostgreSQL (leave POSTGRES_DB empty to use SQLite locally)
POSTGRES_DB=
POSTGRES_USER=terrarisk
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Azure Blob Storage (Member C). Leave empty to store files locally.
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=reports

# Contact details (footer, support page, chatbot)
SUPPORT_EMAIL=support@terrarisk.ai
INSTAGRAM_URL=https://www.instagram.com/your_project_account
TWITTER_URL=https://x.com/your_project_account
GITHUB_URL=https://github.com/your-team/terrarisk

# True = checkout simulates payment and charges nobody. Real payments need a provider such as Stripe.
PAYMENTS_DEMO=True

# False = use the pre-built CSS file (fast, recommended). True = load Tailwind from its CDN while you are
# adding new Tailwind classes to templates (then run the CSS build, see README, and set it back to False).
TAILWIND_CDN=False
